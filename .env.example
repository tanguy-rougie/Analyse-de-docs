# Copier vers .env : copy .env.example .env  (Windows) ou cp .env.example .env

# Chroma (doit correspondre à l'ingestion)
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_COLLECTION=technical_docs

# Retrieval
RETRIEVE_K=5
RERANK_TOP_N=5
USE_RERANKING=false

# LLM local (défaut du projet) — Ollama + llama3.2
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_HTTP_TIMEOUT=600

# OpenAI (si LLM_PROVIDER=openai)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Mistral (si LLM_PROVIDER=mistral)
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Interface web
WEB_HOST=0.0.0.0
WEB_PORT=8000

# PostgreSQL : stocke les jobs, pas les vecteurs.
# Sous Docker Compose, cette valeur est surchargée vers le service postgres.
DATABASE_URL=postgresql+psycopg://analyse:analyse@localhost:5432/analyse

# Worker
WORKER_POLL_INTERVAL=2
WORKER_SIMULATED_DURATION=3
